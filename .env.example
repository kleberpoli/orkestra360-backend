# ==============================================================================
# ORKESTRA360 - ENVIRONMENT VARIABLES TEMPLATE
# Instructions: Copy this file as '.env' and adjust the values as needed.
# DO NOT version the actual '.env' file for security reasons.
# ==============================================================================

# --- DATABASE CONFIG (PostgreSQL) ---
# Database name created on initialization
DB_NAME=orkestra360
# Database user with owner permissions
DB_USER=admin
# Database password (Use a complex one in production)
DB_PASSWORD=orkestra_secret_pass
# Default Postgres port (Internal and External)
DB_PORT=5432

# --- MESSAGING (RabbitMQ) ---
# Administrative user for the broker and management UI
RABBIT_USER=orkestra_user
# Broker password
RABBIT_PASSWORD=rabbitmq_secret_pass
# Port for messaging protocols (AMQP)
RABBIT_PORT_NODE=5672
# Port for the RabbitMQ Management UI dashboard
RABBIT_PORT_MGMT=15672

# --- SPRING BOOT / APP ---
# Active Spring profile: dev (local), test, or prod
SPRING_PROFILES_ACTIVE=dev
# Port where the backend will be exposed
APP_PORT=8080
# JVM heap settings to prevent memory overflow in containers
JVM_OPTS=-Xmx512m -Xms256m

# --- OBSERVABILITY (Phase 4 Prep) ---
# Port for metrics collection (Scraping)
PROMETHEUS_PORT=9090
# Port for dashboard visualization
GRAFANA_PORT=3000